metricHist <- function(dt, var, main="") {
ggplot(dt, aes(.data[[var]]))  +
theme_classic() +
geom_histogram(fill = "lightblue", color = "black") +
ggtitle(main) +
stat_bin(geom="text",
aes(label=ifelse(after_stat(count) == 0, "", after_stat(count))),
vjust = -0.5,
size = 3) +
xlab("") +
ylab("") +
theme(plot.title = element_text(size = 12),
axis.text.x = element_text(size = 8),
axis.text.y = element_text(size = 8)) +
scale_y_continuous(expand = expansion(mult = 0, add = c(0, 100)))
}
pltCharr <- function(tbl) {
charrPlts <- lapply(colnames(tbl)[c(13,14:18)], function(met) {
metricHist(tbl, met, main=met)
})
wrap_plots(charrPlts)
}
