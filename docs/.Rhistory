library(data.table)
library(stringr)
library(DT)
metricHist <- function(dt, var, main="") {
ggplot(dt, aes(.data[[var]]))  +
theme_classic() +
geom_histogram(fill = "lightblue", color = "black") +
ggtitle(main) +
stat_bin(geom="text",
aes(label=ifelse(after_stat(count) == 0, "", after_stat(count))),
vjust = -0.5,
size = 3) +
xlab("") +
ylab("") +
theme(plot.title = element_text(size = 12),
axis.text.x = element_text(size = 8),
axis.text.y = element_text(size = 8)) +
scale_y_continuous(expand = expansion(mult = 0, add = c(0, 100)))
}
pltCharr <- function(tbl) {
charrPlts <- lapply(colnames(tbl)[c(13,14:18)], function(met) {
ggplot(tbl, aes(.data[[met]])) + geom_boxplot() + theme_classic() +
scale_x_continuous(labels = function(x) {
ifelse(x > 1000, scales::label_scientific()(x), x)
}) +
xlab("") +
theme(axis.ticks.y = element_blank(), axis.text.y = element_blank()) +
ggtitle(met)
})
wrap_plots(charrPlts) + plot_annotation(title = "Before Filters")
}
pltReadMets <- function(tbl) {
readPlts <- lapply(colnames(tbl)[c(44,47,48)], function(met) {
metricHist(tbl, met, main=met)
})
wrap_plots(readPlts)
}
pltDosageMets <- function(tbl) {
dosePlts <- lapply(c("wgd_score", "nondiploid_bins"), function(met) {
metricHist(tbl, met, main=met)
})
wrap_plots(dosePlts)
}
